{
  "_doc": "Declarative structural-kernel rewrites. This array is the COMPLETE ordered rule registry (load_rules() builds it in this order; within a phase, order = array order). Most entries are declarative: a `premise` mapping reusable predicate names (EdgeMatchedBy / SourceMatchedBy / TargetMatchedBy / SlotIsType / HasProperty / PropertyValueCount / PropertyMatchedBy / NodePropertyMatchedBy / PropertyHasPromotableContent, plus structural escape-hatch predicates) to value lists (ALL premises hold, each ORs over its values) and an ordered `consequence` list (Move / Append / ReplaceSlot / Drop / PromoteToTarget / Flatten, plus structural/graph escape-hatch ops). A few entries are `impl: \"module:ClassName\"` references to a Python StructuralRewriteRule subclass for rewrites too bespoke to express as data (heavy graph traversal / multi-pass surgery). Vocabulary classes (StateVerb, LocationLike, ...) resolve via KernelOntologyMatchers.matches_class against HOnK / raw_data — keep lexical/class membership there, not in this file. See declarative.py for the predicate/consequence vocabulary.",
  "lexical_sets": {
    "case_prepositions_ignored_for_kernel_targets": ["by", "'s", "of", "’s"],
    "context_entity_types": ["DATE", "TIME", "SUTime", "GPE", "LOC", "FAC", "existential"],
    "spatial_relation_types": [
      "stay in place",
      "near place",
      "motion to place",
      "motion from place",
      "motion through place"
    ]
  },
  "rules": [
    {"impl": "pseudo_verb_copula_recovery:PseudoVerbCopulaRecoveryRule"},
    {"impl": "copula_complement_promotion:CopulaComplementPromotionRule"},
    {"impl": "existential_locative_to_have:ExistentialLocativeToHaveRule"},
    {
      "name": "promote_source_reduced_relative",
      "phase": "post_logical_rewrite",
      "premise": {"SourceAndHasReducedRelativeVerb": []},
      "consequence": [{"PromoteSourceReducedRelative": {}}]
    },
    {
      "name": "state_cause_access_point_swap",
      "phase": "post_logical_rewrite",
      "uses_honk_sets": ["StateVerb", "CausalNode", "LocationLike", "AccessPointLike"],
      "premise": {
        "EdgeMatchedBy": ["StateVerb"],
        "SourceMatchedBy": ["CausalNode"],
        "TargetMatchedBy": ["LocationLike"],
        "PropertyMatchedBy": ["SPACE:AccessPointLike"]
      },
      "consequence": [
        {"Move": {"property": "SPACE", "select": "matched", "intoSlot": "target"}},
        {"Append": {"property": "SPACE", "from": "target"}},
        {"Append": {"property": "CAUSATION", "from": "source"}},
        {"ReplaceSlot": {"slot": "source", "with": "existential"}}
      ]
    },
    {"impl": "stative_eventive_swap:StativeEventiveSwapRule"},
    {"impl": "specification_into_space:FoldSpecificationIntoSpaceRule"},
    {
      "name": "relcl_target_lift",
      "phase": "post_logical_rewrite",
      "premise": {"GraphAclRecoverable": []},
      "consequence": [{"GraphAclRecoveredTarget": {}}]
    },
    {"impl": "requirement_simplifier:RequirementClauseSimplifierRule"},
    {"impl": "logical_context_clause_dedupe:LogicalContextClauseDedupeRule"},
    {"impl": "passive_progressive:PassiveProgressiveRewrite"},
    {"impl": "existential_passive_and_promote:ExistentialPassiveAndPromoteRule"},
    {
      "name": "strip_aux_from_edge_label",
      "phase": "post_logical_rewrite",
      "premise": {"EdgeHasLeadingCopulaAux": []},
      "consequence": [{"StripLeadingCopula": {}}]
    },
    {
      "name": "lift_conjunct_context_to_kernel",
      "phase": "post_logical_rewrite",
      "premise": {"AndConjunctHasContextProperty": []},
      "consequence": [{"LiftConjunctContext": {}}]
    },
    {
      "name": "drop_temporal_from_space",
      "phase": "post_logical_rewrite",
      "premise": {"SpaceHasTemporalEntries": []},
      "consequence": [{"DropTemporalFromSpace": {}}]
    },
    {
      "name": "orientation_space_to_specification",
      "phase": "post_logical_rewrite",
      "uses_honk_sets": ["OrientationNoun"],
      "premise": {"PropertyMatchedBy": ["SPACE:OrientationNoun"]},
      "consequence": [{"Move": {"property": "SPACE", "select": "matched", "intoProperty": "SPECIFICATION"}}]
    },
    {
      "name": "singleton_and_location_to_space",
      "phase": "post_logical_rewrite",
      "uses_honk_sets": ["LocationLike"],
      "premise": {
        "PropertyValueCount": ["AND:1"],
        "PropertyMatchedBy": ["AND:LocationLike"]
      },
      "consequence": [{"Move": {"property": "AND", "intoProperty": "SPACE"}}]
    },
    {
      "name": "content_source_spatial_target_to_space",
      "phase": "post_logical_rewrite",
      "uses_honk_sets": ["ContentNode", "LocationLike"],
      "premise": {
        "SourceMatchedBy": ["ContentNode"],
        "TargetMatchedBy": ["LocationLike"],
        "SlotHasConstructPreposition": ["target:space"]
      },
      "not_premise": {
        "SlotIsType": ["source=GPE", "source=LOC", "source=FAC"]
      },
      "consequence": [
        {"Append": {"property": "SPACE", "from": "target"}},
        {"ReplaceSlot": {"slot": "target", "with": "source"}},
        {"ReplaceSlot": {"slot": "source", "with": "existential"}}
      ]
    },
    {"impl": "geo_extra_to_space:GeoExtraToSpaceRule"},
    {"impl": "participial_collapse:ParticipialCollapseRule"},
    {"impl": "participial_sub_kernel_preserve:ParticipialSubKernelPreserveRule"},
    {"impl": "participial_predicate_promotion:ParticipialPredicatePromotionRule"},
    {"impl": "lifecycle_property_promotion:LifecyclePropertyPromotionRule"},
    {"impl": "lifecycle_property_promotion:LifecyclePropertyPromotionLateRule"},
    {"impl": "status_verb_into_time_status:StatusVerbIntoTimeStatusRule"},
