        "EdgeMatchedBy": ["ChangeOfStateVerb"],
        "NodePropertyMatchedBy": ["TEMPORAL_CONTEXT.type:OccurrenceVerb"]
      },
      "consequence": [{"Move": {"property": "TEMPORAL_CONTEXT", "select": "matched", "intoProperty": "CAUSATION"}}]
    },
    {"impl": "auxiliary_periphrasis_promotion:AuxiliaryPeriphrasisPromotionRule"},
    {"impl": "action_object_promotion:ActionObjectPromotionRule"},
