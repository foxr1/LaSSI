    },
    {
      "name": "and_nmod_extra",
      "phase": "post_logical_rewrite",
      "premise": {"GraphNmodExtraCandidates": []},
      "consequence": [{"GraphNmodExtra": {}}]
    },
    {
      "name": "and_compound_classifier_extra",
      "phase": "post_logical_rewrite",
      "uses_honk_sets": ["EventClassifierHeadNoun"],
      "premise": {"GraphCompoundClassifierHeadCandidates": ["EventClassifierHeadNoun"]},
      "consequence": [{"GraphCompoundClassifierHead": {}}]
    },
    {
      "name": "lifecycle_subject_promotion",
      "phase": "post_logical_rewrite",
