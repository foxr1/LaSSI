@prefix rdf:       <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:      <http://www.w3.org/2000/01/rdf-schema#> .
@prefix lifecycle: <https://ofox.co.uk/lifecycle#> .

# ---------------------------------------------------------------------------
# LifecycleStates.ttl — mutually-exclusive status terms for LaSSI ex-post
# comparison.  Mirrors Paraphrase.ttl but inverted: phrases in the same
# dimension that carry *different* partition tags are mutually exclusive.
#
# Schema
# ------
# lifecycle:LifecycleDimension — a named axis of lifecycle (e.g. "case status").
# lifecycle:LifecyclePhrase    — a phrase that lives on that axis.
# lifecycle:memberOf           — links a phrase to its dimension.
# lifecycle:partition          — bucket label within the dimension.  Two phrases
#                                in the same dimension contradict iff their
#                                partition strings differ.
# rdfs:label on a dimension    — internal dimension tag.
# rdfs:label on a phrase       — the lowercase surface string to match against
#                                a predicate's rel, property values, FVariable
#                                names/specifications, and nested type props.
# rdfs:comment                 — example sentence(s) that motivated the entry.
# ---------------------------------------------------------------------------

lifecycle:CaseLifecycle
    a lifecycle:LifecycleDimension ;
    rdfs:label "case_lifecycle" ;
    rdfs:comment "e.g. 'Bicycle theft … under investigation' vs 'The bicycle theft … has concluded with a suspect being charged.'" .

# ---------- Open / ongoing ----------

lifecycle:phrase_under_investigation
    a lifecycle:LifecyclePhrase ;
    rdfs:label "under_investigation" ;
    lifecycle:memberOf lifecycle:CaseLifecycle ;
    lifecycle:partition "open" .

lifecycle:phrase_investigation
    a lifecycle:LifecyclePhrase ;
    rdfs:label "investigation" ;
    lifecycle:memberOf lifecycle:CaseLifecycle ;
    lifecycle:partition "open" .

lifecycle:phrase_pending
    a lifecycle:LifecyclePhrase ;
    rdfs:label "pending" ;
    lifecycle:memberOf lifecycle:CaseLifecycle ;
    lifecycle:partition "open" .

lifecycle:phrase_ongoing
    a lifecycle:LifecyclePhrase ;
    rdfs:label "ongoing" ;
    lifecycle:memberOf lifecycle:CaseLifecycle ;
    lifecycle:partition "open" .

lifecycle:phrase_open
    a lifecycle:LifecyclePhrase ;
    rdfs:label "open" ;
    lifecycle:memberOf lifecycle:CaseLifecycle ;
    lifecycle:partition "open" .

# ---------- Closed / resolved ----------

lifecycle:phrase_concluded
    a lifecycle:LifecyclePhrase ;
    rdfs:label "concluded" ;
    lifecycle:memberOf lifecycle:CaseLifecycle ;
    lifecycle:partition "closed" .

lifecycle:phrase_conclude
    a lifecycle:LifecyclePhrase ;
    rdfs:label "conclude" ;
    lifecycle:memberOf lifecycle:CaseLifecycle ;
    lifecycle:partition "closed" .

lifecycle:phrase_charged
    a lifecycle:LifecyclePhrase ;
    rdfs:label "charged" ;
    lifecycle:memberOf lifecycle:CaseLifecycle ;
    lifecycle:partition "closed" .

lifecycle:phrase_dismissed
    a lifecycle:LifecyclePhrase ;
    rdfs:label "dismissed" ;
    lifecycle:memberOf lifecycle:CaseLifecycle ;
    lifecycle:partition "closed" .

lifecycle:phrase_resolved
    a lifecycle:LifecyclePhrase ;
    rdfs:label "resolved" ;
    lifecycle:memberOf lifecycle:CaseLifecycle ;
    lifecycle:partition "closed" .

lifecycle:phrase_closed
    a lifecycle:LifecyclePhrase ;
    rdfs:label "closed" ;
    lifecycle:memberOf lifecycle:CaseLifecycle ;
    lifecycle:partition "closed" .

# ---------- Descriptive / event-facet (no state claim) ----------
# Verbs that talk about the event without asserting a case-lifecycle stage.
# Same dimension as open/closed, but a distinct "descriptive" partition: the
# partition check never contradicts these against open or closed, yet they
# still register as lifecycle-aware indicators so that an open/closed claim
# on the other side is detected as an asymmetric assertion.

lifecycle:phrase_record
    a lifecycle:LifecyclePhrase ;
    rdfs:label "record" ;
    lifecycle:memberOf lifecycle:CaseLifecycle ;
    lifecycle:partition "descriptive" .

lifecycle:phrase_recorded
    a lifecycle:LifecyclePhrase ;
    rdfs:label "recorded" ;
    lifecycle:memberOf lifecycle:CaseLifecycle ;
    lifecycle:partition "descriptive" .

lifecycle:phrase_involve
    a lifecycle:LifecyclePhrase ;
    rdfs:label "involve" ;
    lifecycle:memberOf lifecycle:CaseLifecycle ;
    lifecycle:partition "descriptive" .

lifecycle:phrase_involved
    a lifecycle:LifecyclePhrase ;
    rdfs:label "involved" ;
    lifecycle:memberOf lifecycle:CaseLifecycle ;
    lifecycle:partition "descriptive" .

lifecycle:phrase_describe
    a lifecycle:LifecyclePhrase ;
    rdfs:label "describe" ;
    lifecycle:memberOf lifecycle:CaseLifecycle ;
    lifecycle:partition "descriptive" .

lifecycle:phrase_described
    a lifecycle:LifecyclePhrase ;
    rdfs:label "described" ;
    lifecycle:memberOf lifecycle:CaseLifecycle ;
    lifecycle:partition "descriptive" .

lifecycle:phrase_mention
    a lifecycle:LifecyclePhrase ;
    rdfs:label "mention" ;
    lifecycle:memberOf lifecycle:CaseLifecycle ;
    lifecycle:partition "descriptive" .

lifecycle:phrase_mentioned
    a lifecycle:LifecyclePhrase ;
    rdfs:label "mentioned" ;
    lifecycle:memberOf lifecycle:CaseLifecycle ;
    lifecycle:partition "descriptive" .

# ---------------------------------------------------------------------------
# Suspect-resolution dimension — whether a crime/outcome text asserts that a
# suspect exists or that no suspect was identified.
# ---------------------------------------------------------------------------

lifecycle:SuspectResolution
    a lifecycle:LifecycleDimension ;
    rdfs:label "suspect_resolution" ;
    rdfs:comment "e.g. 'no suspect identified' vs 'several suspects were arrested'." .

# ---------- Suspect present / actioned ----------

lifecycle:phrase_suspect_present_singular
    a lifecycle:LifecyclePhrase ;
    rdfs:label "suspect" ;
    lifecycle:memberOf lifecycle:SuspectResolution ;
    lifecycle:partition "present" .

lifecycle:phrase_suspect_present_plural
    a lifecycle:LifecyclePhrase ;
    rdfs:label "suspects" ;
    lifecycle:memberOf lifecycle:SuspectResolution ;
    lifecycle:partition "present" .

lifecycle:phrase_arrest
    a lifecycle:LifecyclePhrase ;
    rdfs:label "arrest" ;
    lifecycle:memberOf lifecycle:SuspectResolution ;
    lifecycle:partition "present" .

lifecycle:phrase_arrested
    a lifecycle:LifecyclePhrase ;
    rdfs:label "arrested" ;
    lifecycle:memberOf lifecycle:SuspectResolution ;
    lifecycle:partition "present" .

lifecycle:phrase_charge
    a lifecycle:LifecyclePhrase ;
    rdfs:label "charge" ;
    lifecycle:memberOf lifecycle:SuspectResolution ;
    lifecycle:partition "present" .

lifecycle:phrase_charged_suspect_resolution
    a lifecycle:LifecyclePhrase ;
    rdfs:label "charged" ;
    lifecycle:memberOf lifecycle:SuspectResolution ;
    lifecycle:partition "present" .

# ---------- No suspect identified ----------

lifecycle:phrase_no_suspect
    a lifecycle:LifecyclePhrase ;
    rdfs:label "no suspect" ;
    lifecycle:memberOf lifecycle:SuspectResolution ;
    lifecycle:partition "absent" .

lifecycle:phrase_no_suspect_identified
    a lifecycle:LifecyclePhrase ;
    rdfs:label "no suspect identified" ;
    lifecycle:memberOf lifecycle:SuspectResolution ;
    lifecycle:partition "absent" .

lifecycle:phrase_unidentified
    a lifecycle:LifecyclePhrase ;
    rdfs:label "unidentified" ;
    lifecycle:memberOf lifecycle:SuspectResolution ;
    lifecycle:partition "absent" .

# ---------------------------------------------------------------------------
# Weather precipitation dimension — wet vs dry forecast assertions.
# Phrases on opposite partitions contradict, giving us the "neqTo" between
# e.g. 'rain' and 'dry' that the underlying HOnK ontology does not encode.
#
# Source sentences: weather_002–weather_008 evidence cases pair a forecast
# describing rain/precipitation with one describing dry/no-rain conditions.
# ---------------------------------------------------------------------------

lifecycle:WeatherPrecipitation
    a lifecycle:LifecycleDimension ;
    rdfs:label "weather_precipitation" ;
    rdfs:comment "e.g. 'Newcastle is forecast to have light rain.' vs 'Newcastle is forecast to have dry and clear conditions with no rain.'" .

# ---------- Wet ----------

lifecycle:phrase_rain
    a lifecycle:LifecyclePhrase ;
    rdfs:label "rain" ;
    lifecycle:memberOf lifecycle:WeatherPrecipitation ;
    lifecycle:partition "wet" .

lifecycle:phrase_raining
    a lifecycle:LifecyclePhrase ;
    rdfs:label "raining" ;
    lifecycle:memberOf lifecycle:WeatherPrecipitation ;
    lifecycle:partition "wet" .

lifecycle:phrase_rainfall
    a lifecycle:LifecyclePhrase ;
    rdfs:label "rainfall" ;
    lifecycle:memberOf lifecycle:WeatherPrecipitation ;
    lifecycle:partition "wet" .

lifecycle:phrase_precipitation
    a lifecycle:LifecyclePhrase ;
    rdfs:label "precipitation" ;
    lifecycle:memberOf lifecycle:WeatherPrecipitation ;
    lifecycle:partition "wet" .

lifecycle:phrase_shower
    a lifecycle:LifecyclePhrase ;
    rdfs:label "shower" ;
    lifecycle:memberOf lifecycle:WeatherPrecipitation ;
    lifecycle:partition "wet" .

lifecycle:phrase_rain_shower
    a lifecycle:LifecyclePhrase ;
    rdfs:label "rain shower" ;
    lifecycle:memberOf lifecycle:WeatherPrecipitation ;
    lifecycle:partition "wet" .

lifecycle:phrase_drizzle
    a lifecycle:LifecyclePhrase ;
    rdfs:label "drizzle" ;
    lifecycle:memberOf lifecycle:WeatherPrecipitation ;
    lifecycle:partition "wet" .

lifecycle:phrase_wet
    a lifecycle:LifecyclePhrase ;
    rdfs:label "wet" ;
    lifecycle:memberOf lifecycle:WeatherPrecipitation ;
    lifecycle:partition "wet" .

# ---------- Dry ----------

lifecycle:phrase_dry
    a lifecycle:LifecyclePhrase ;
    rdfs:label "dry" ;
    lifecycle:memberOf lifecycle:WeatherPrecipitation ;
    lifecycle:partition "dry" .

lifecycle:phrase_arid
    a lifecycle:LifecyclePhrase ;
    rdfs:label "arid" ;
    lifecycle:memberOf lifecycle:WeatherPrecipitation ;
    lifecycle:partition "dry" .

# ---------------------------------------------------------------------------
# Sky-cover dimension — cloudy vs clear forecast assertions.
# Used by weather_002/003/004/005/006/007/008 where forecasts describe the
# sky as cloudy/overcast on one side and clear/sunny on the other.
# ---------------------------------------------------------------------------

lifecycle:SkyCondition
    a lifecycle:LifecycleDimension ;
    rdfs:label "sky_condition" ;
    rdfs:comment "e.g. 'Newcastle is expected to be cloudy.' vs 'Newcastle is forecast to have clear skies with no clouds.'" .

# ---------- Overcast ----------

lifecycle:phrase_cloudy
    a lifecycle:LifecyclePhrase ;
    rdfs:label "cloudy" ;
    lifecycle:memberOf lifecycle:SkyCondition ;
    lifecycle:partition "overcast" .

lifecycle:phrase_overcast
    a lifecycle:LifecyclePhrase ;
    rdfs:label "overcast" ;
    lifecycle:memberOf lifecycle:SkyCondition ;
    lifecycle:partition "overcast" .

lifecycle:phrase_clouds
    a lifecycle:LifecyclePhrase ;
    rdfs:label "clouds" ;
    lifecycle:memberOf lifecycle:SkyCondition ;
    lifecycle:partition "overcast" .

lifecycle:phrase_cloud
    a lifecycle:LifecyclePhrase ;
    rdfs:label "cloud" ;
    lifecycle:memberOf lifecycle:SkyCondition ;
    lifecycle:partition "overcast" .

# ---------- Clear ----------

lifecycle:phrase_clear
    a lifecycle:LifecyclePhrase ;
    rdfs:label "clear" ;
    lifecycle:memberOf lifecycle:SkyCondition ;
    lifecycle:partition "clear" .

lifecycle:phrase_clear_skies
    a lifecycle:LifecyclePhrase ;
    rdfs:label "clear skies" ;
    lifecycle:memberOf lifecycle:SkyCondition ;
    lifecycle:partition "clear" .

lifecycle:phrase_sunny
    a lifecycle:LifecyclePhrase ;
    rdfs:label "sunny" ;
    lifecycle:memberOf lifecycle:SkyCondition ;
    lifecycle:partition "clear" .

lifecycle:phrase_sunny_spells
    a lifecycle:LifecyclePhrase ;
    rdfs:label "sunny spells" ;
    lifecycle:memberOf lifecycle:SkyCondition ;
    lifecycle:partition "clear" .

# ---------------------------------------------------------------------------
# Flood-alert presence dimension — used by weather_001 where the Environment
# Agency either reports active flood warnings/alerts or reports their absence.
# ---------------------------------------------------------------------------

lifecycle:FloodAlertPresence
    a lifecycle:LifecycleDimension ;
    rdfs:label "flood_alert_presence" ;
    rdfs:comment "e.g. 'The Environment Agency reports no active flood warnings.' vs 'The Environment Agency has issued active flood warnings.'" .

lifecycle:phrase_active
    a lifecycle:LifecyclePhrase ;
    rdfs:label "active" ;
    lifecycle:memberOf lifecycle:FloodAlertPresence ;
    lifecycle:partition "present" .

lifecycle:phrase_issued
    a lifecycle:LifecyclePhrase ;
    rdfs:label "issued" ;
    lifecycle:memberOf lifecycle:FloodAlertPresence ;
    lifecycle:partition "present" .

lifecycle:phrase_absence
    a lifecycle:LifecyclePhrase ;
    rdfs:label "absence" ;
    lifecycle:memberOf lifecycle:FloodAlertPresence ;
    lifecycle:partition "absent" .

# ---------------------------------------------------------------------------
# Precipitation-intensity dimension — magnitude of rain asserted by a
# forecast, distinct from the wet/dry binary above.  "Persistent heavy
# rain" asserts effectively 100% rain (high partition); "very low /
# 9% chance of precipitation" asserts effectively no rain (low partition).
# Both sides still mention rain/precipitation so the weather_precipitation
# dimension classes them together as 'wet' — the contradiction has to come
# from intensity, not presence.
#
# Why "very low" suffices for the low side: numeric chance percentages in
# the 1–9% band are canonicalised to the "very low" surface form by
# Paraphrase.ttl::VeryLowProbability (numericMin 1, numericMax 9,
# numericDomain ChanceNoun), so a "9% chance of precipitation" predicate
# carries a cop labelled "very low" by the time the lifecycle phrase
# matcher inspects it.
#
# Source sentences: weather_005 — "persistent heavy rain" (s2) vs
# "9% chance of precipitation" (s0) / "very low chance of rain" (s1).
# ---------------------------------------------------------------------------

lifecycle:PrecipitationIntensity
    a lifecycle:LifecycleDimension ;
    rdfs:label "precipitation_intensity" ;
    rdfs:comment "e.g. 'Newcastle is forecast to have persistent heavy rain.' vs 'Newcastle is expected to be cloudy with a very low chance of rain.' / '9% chance of precipitation.'" .

# ---------- High intensity / certain rain ----------

lifecycle:phrase_persistent
    a lifecycle:LifecyclePhrase ;
    rdfs:label "persistent" ;
    lifecycle:memberOf lifecycle:PrecipitationIntensity ;
    lifecycle:partition "high" .

lifecycle:phrase_heavy
    a lifecycle:LifecyclePhrase ;
    rdfs:label "heavy" ;
    lifecycle:memberOf lifecycle:PrecipitationIntensity ;
    lifecycle:partition "high" .

lifecycle:phrase_torrential
    a lifecycle:LifecyclePhrase ;
    rdfs:label "torrential" ;
    lifecycle:memberOf lifecycle:PrecipitationIntensity ;
    lifecycle:partition "high" .

lifecycle:phrase_downpour
    a lifecycle:LifecyclePhrase ;
    rdfs:label "downpour" ;
    lifecycle:memberOf lifecycle:PrecipitationIntensity ;
    lifecycle:partition "high" .

# ---------- Low intensity / unlikely rain ----------

lifecycle:phrase_very_low
    a lifecycle:LifecyclePhrase ;
    rdfs:label "very low" ;
    lifecycle:memberOf lifecycle:PrecipitationIntensity ;
    lifecycle:partition "low" .
