@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix para: <https://ofox.co.uk/paraphrase#> .

# ---------------------------------------------------------------------------
# Paraphrase.ttl — domain paraphrase concepts for LaSSI ex-post comparison.
#
# Schema
# ------
# para:ParaphraseConcept  — a named group of surface-distinct phrases that
#                           denote the same idea.
# para:ParaphrasePhrase   — one phrase that belongs to a concept.
# para:memberOf           — links a phrase to its concept.
# para:form               — "name"      : the phrase is a bare FVariable name
#                           "fnot_name" : the phrase is the inner name of a
#                                         FNot(FVariable(name=...)) expression
# para:numericMin / para:numericMax — OPTIONAL closed-interval bounds on a
#                           concept.  Any FVariable whose name parses as a
#                           number (tolerating a trailing '%' and the
#                           LaSSI-specific "<dot>" placeholder, e.g.
#                           "12<dot>76") falls into the concept iff the value
#                           is in [min, max].  Either bound may be omitted to
#                           leave that side open.  Use these instead of
#                           enumerating every numeric phrase ("57","58",…)
#                           when the concept is about a magnitude band rather
#                           than specific observed values.
# para:numericDomain      — OPTIONAL scoping for a range-bearing concept: a
#                           reference to ANOTHER ParaphraseConcept whose
#                           members denote valid host head-nouns.  A numeric
#                           range only fires when the FVariable being matched
#                           sits as the `cop` of a parent FVariable whose own
#                           name belongs to the named domain concept.
#                           Without this, "12<dot>76" (a temperature) would
#                           land in OneInSixProbability simply because it
#                           parses to a number inside the range; scoping it
#                           to `numericDomain para:ChanceNoun` restricts the
#                           range to children of `chance`/`% chance`/`likelihood`
#                           /`probability`.  May be declared multiple times
#                           for a concept covered by several host families.
# rdfs:label on a concept — the internal concept tag (used as dict key)
# rdfs:label on a phrase  — the lowercase surface string to match
# rdfs:comment on concept — example sentence that motivated the entry
# ---------------------------------------------------------------------------

para:IndefiniteSuspension
    a para:ParaphraseConcept ;
    rdfs:label "indefinite_suspension" ;
    rdfs:comment "e.g. 'Millbrae Station is closed until further notice due to maintenance work.' vs 'There is no fixed reopening date for the station.'" .

para:phrase_until_further_notice
    a para:ParaphrasePhrase ;
    rdfs:label "until further notice" ;
    para:memberOf para:IndefiniteSuspension ;
    para:form "name" .

para:phrase_indefinitely
    a para:ParaphrasePhrase ;
    rdfs:label "indefinitely" ;
    para:memberOf para:IndefiniteSuspension ;
    para:form "name" .

para:phrase_reopening
    a para:ParaphrasePhrase ;
    rdfs:label "reopening" ;
    para:memberOf para:IndefiniteSuspension ;
    para:form "fnot_name" .

para:phrase_resumption
    a para:ParaphrasePhrase ;
    rdfs:label "resumption" ;
    para:memberOf para:IndefiniteSuspension ;
    para:form "fnot_name" .

para:phrase_restart
    a para:ParaphrasePhrase ;
    rdfs:label "restart" ;
    para:memberOf para:IndefiniteSuspension ;
    para:form "fnot_name" .

para:UniversityStation
    a para:ParaphraseConcept ;
    rdfs:label "university_station" ;
    rdfs:comment "University station and University metro station are the same thing." .

para:phrase_university_station
    a para:ParaphrasePhrase ;
    rdfs:label "university station" ;
    para:memberOf para:UniversityStation ;
    para:form "name" .

para:phrase_university_metro_station
    a para:ParaphrasePhrase ;
    rdfs:label "university metro station" ;
    para:memberOf para:UniversityStation ;
    para:form "name" .

# ---------------------------------------------------------------------------
# Forecast/reporting assertion heads.
#
# Weather evidence frequently alternates between "is forecast to ..." and
# "is expected to ...". In these contexts both terms introduce a forecasted
# proposition rather than changing the weather content itself. Grouping the
# heads here lets source predicates such as `forecast` and `expect` line up
# before the real comparison happens on the destination condition.
# ---------------------------------------------------------------------------

para:ForecastAssertion
    a para:ParaphraseConcept ;
    rdfs:label "forecast_assertion" ;
    rdfs:comment "e.g. 'Newcastle is forecast to have cloudy weather.' vs 'Newcastle is expected to be cloudy.'" .

para:phrase_forecast
    a para:ParaphrasePhrase ;
    rdfs:label "forecast" ;
    para:memberOf para:ForecastAssertion ;
    para:form "name" .

para:phrase_expected
    a para:ParaphrasePhrase ;
    rdfs:label "expected" ;
    para:memberOf para:ForecastAssertion ;
    para:form "name" .

para:phrase_expect
    a para:ParaphrasePhrase ;
    rdfs:label "expect" ;
    para:memberOf para:ForecastAssertion ;
    para:form "name" .

# ---------------------------------------------------------------------------
# Semantically-empty hedges.
#
# Adverbs (and similar surface tokens) that don't change the truth of the
# host predicate and are routinely added/dropped between paraphrases.
# Examples: "currently under investigation" vs "under investigation",
# "roadworks are currently taking place" vs "roadworks are taking place".
#
# Membership marks a phrase as ignorable when it appears on only one side
# of an ex-post comparison: `_compare_fvar_properties` drops the key
# rather than penalising the asymmetry. Adverbs that DO change meaning
# (e.g. "very", "fully", "most", "normally") must NOT be added here —
# they belong to their own concepts or are left unparaphrased.
# ---------------------------------------------------------------------------

para:SemanticallyEmptyHedge
    a para:ParaphraseConcept ;
    rdfs:label "semantically_empty_hedge" ;
    rdfs:comment "e.g. 'A burglary is currently under investigation.' vs 'A burglary is under investigation.'" .

para:phrase_currently
    a para:ParaphrasePhrase ;
    rdfs:label "currently" ;
    para:memberOf para:SemanticallyEmptyHedge ;
    para:form "name" .

# ---------------------------------------------------------------------------
# Weather precipitation nouns.
#
# Forecast data may describe the same wet-weather phenomenon as "rain",
# "rainfall", or "precipitation". This concept captures the lexical
# equivalence; LifecycleStates.ttl still carries wet/dry and intensity
# partitions for contradictions.
# ---------------------------------------------------------------------------

para:WeatherPrecipitationNoun
    a para:ParaphraseConcept ;
    rdfs:label "weather_precipitation_noun" ;
    rdfs:comment "e.g. '9% chance of precipitation' vs 'very low chance of rain'." .

para:phrase_rain
    a para:ParaphrasePhrase ;
    rdfs:label "rain" ;
    para:memberOf para:WeatherPrecipitationNoun ;
    para:form "name" .

para:phrase_precipitation
    a para:ParaphrasePhrase ;
    rdfs:label "precipitation" ;
    para:memberOf para:WeatherPrecipitationNoun ;
    para:form "name" .

para:phrase_rainfall
    a para:ParaphrasePhrase ;
    rdfs:label "rainfall" ;
    para:memberOf para:WeatherPrecipitationNoun ;
    para:form "name" .

# ---------------------------------------------------------------------------
# Chance / probability head-nouns.
#
# The Stanza+gsm pipeline parses "<N>% chance" as a single head FVariable named
# "% chance" (with the integer in cop), while "<adjective> chance" — e.g.
# "better-than-even chance", "one-in-six chance", "very low chance" — comes out
# as the bare head FVariable "chance" (with the qualifier in amod/cop). Without
# this concept the two head-nouns never line up, so a probability claim with a
# numeric form and one with a natural-language qualifier are compared as
# unrelated terms. Grouping them here is just head-noun unification; the
# magnitude buckets below carry the actual probability semantics.
# ---------------------------------------------------------------------------

para:ChanceNoun
    a para:ParaphraseConcept ;
    rdfs:label "chance_noun" ;
    rdfs:comment "e.g. '57% chance of precipitation' vs 'better-than-even chance of precipitation' — same head concept, different magnitude." .

para:phrase_pct_chance
    a para:ParaphrasePhrase ;
    rdfs:label "% chance" ;
    para:memberOf para:ChanceNoun ;
    para:form "name" .

para:phrase_chance
    a para:ParaphrasePhrase ;
    rdfs:label "chance" ;
    para:memberOf para:ChanceNoun ;
    para:form "name" .

para:phrase_likelihood
    a para:ParaphrasePhrase ;
    rdfs:label "likelihood" ;
    para:memberOf para:ChanceNoun ;
    para:form "name" .

para:phrase_probability
    a para:ParaphrasePhrase ;
    rdfs:label "probability" ;
    para:memberOf para:ChanceNoun ;
    para:form "name" .

# ---------------------------------------------------------------------------
# Probability magnitude buckets.
#
# Each concept binds the numeric percentage that appears as the cop of
# "% chance" to the natural-language qualifier that appears as the amod/cop of
# bare "chance". The fractions "one-in-N" are bucketed to the closest integer
# percent observed in the Met Office data:
#   "one-in-three"  ≈ 33%  → matches 34%
#   "one-in-four"   ≈ 25%  → matches 27% (closest observed)
#   "one-in-six"    ≈ 17%  → matches 16%
#   "one-in-ten"    ≈ 10%  → matches 10%
#   "better-than-even" > 50% → matches 57%
#   "very low"      < ~10% → matches 7% and 9%
# ---------------------------------------------------------------------------

para:BetterThanEvenProbability
    a para:ParaphraseConcept ;
    rdfs:label "better_than_even_probability" ;
    para:numericMin 51 ;
    para:numericMax 100 ;
    para:numericDomain para:ChanceNoun ;
    rdfs:comment "e.g. '57% chance of precipitation' vs 'better-than-even chance of precipitation'.  Any percentage strictly greater than 50 lands here via the numeric range — explicit phrase members below are kept for documentation but are redundant once the range is in place.  Range scoped to ChanceNoun so that a numeric value parsed as 57 from, say, °C(cop:57) does NOT collapse into this bucket." .

para:phrase_better_than_even
    a para:ParaphrasePhrase ;
    rdfs:label "better-than-even" ;
    para:memberOf para:BetterThanEvenProbability ;
    para:form "name" .

para:OneInThreeProbability
    a para:ParaphraseConcept ;
    rdfs:label "one_in_three_probability" ;
    para:numericMin 30 ;
    para:numericMax 40 ;
    para:numericDomain para:ChanceNoun ;
    rdfs:comment "e.g. '34% chance of precipitation' vs 'one-in-three chance of rain' (≈33%).  Range covers values that round to ≈1/3." .

para:phrase_one_in_three
    a para:ParaphrasePhrase ;
    rdfs:label "one-in-three" ;
    para:memberOf para:OneInThreeProbability ;
    para:form "name" .

para:OneInFourProbability
    a para:ParaphraseConcept ;
    rdfs:label "one_in_four_probability" ;
    para:numericMin 23 ;
    para:numericMax 29 ;
    para:numericDomain para:ChanceNoun ;
    rdfs:comment "e.g. '27% chance of precipitation' vs 'one-in-four chance of rain' (≈25%)." .

para:phrase_one_in_four
    a para:ParaphrasePhrase ;
    rdfs:label "one-in-four" ;
    para:memberOf para:OneInFourProbability ;
    para:form "name" .

para:OneInSixProbability
    a para:ParaphraseConcept ;
    rdfs:label "one_in_six_probability" ;
    para:numericMin 11 ;
    para:numericMax 22 ;
    para:numericDomain para:ChanceNoun ;
    rdfs:comment "e.g. '16% chance of precipitation' vs 'one-in-six chance of rain' (≈16.7%)." .

para:phrase_one_in_six
    a para:ParaphrasePhrase ;
    rdfs:label "one-in-six" ;
    para:memberOf para:OneInSixProbability ;
    para:form "name" .

para:OneInTenProbability
    a para:ParaphraseConcept ;
    rdfs:label "one_in_ten_probability" ;
    para:numericMin 10 ;
    para:numericMax 10 ;
    para:numericDomain para:ChanceNoun ;
    rdfs:comment "e.g. '10% chance of precipitation' vs 'one-in-ten chance of rain'.  Narrow range — 'one-in-ten' is a specific bucket, not a band." .

para:phrase_one_in_ten
    a para:ParaphrasePhrase ;
    rdfs:label "one-in-ten" ;
    para:memberOf para:OneInTenProbability ;
    para:form "name" .

para:VeryLowProbability
    a para:ParaphraseConcept ;
    rdfs:label "very_low_probability" ;
    para:numericMin 1 ;
    para:numericMax 9 ;
    para:numericDomain para:ChanceNoun ;
    rdfs:comment "e.g. '7%/9% chance of precipitation' vs 'very low chance of rain' — single-digit probability." .

para:phrase_very_low
    a para:ParaphrasePhrase ;
    rdfs:label "very low" ;
    para:memberOf para:VeryLowProbability ;
    para:form "name" .

# ---------------------------------------------------------------------------
# Causal / temporal-causal connectives.
#
# Sentences expressing the same cause-effect link surface with different
# connectives — "closed following storm damage" vs "closed due to storm
# damage" vs "closed because of storm damage". The Stanza+gsm pipeline
# sometimes collapses these into a single `actioned:<connective>` property
# on the cause node (e.g. `actioned:following`); other times the connective
# is left as raw numbered case markers on the node (e.g. `3:Due`, `4:to`
# for "Due to"). Reconstructing the surface phrase from those numbered
# markers (ordering by the integer prefix) and looking it up here lets the
# ex-post comparator treat the two parses as the same causal link without
# blanket-ignoring `actioned:` properties (which carry real meaning when
# the connective differs, e.g. "despite" vs "following").
# ---------------------------------------------------------------------------

para:CausalConnective
    a para:ParaphraseConcept ;
    rdfs:label "causal_connective" ;
    rdfs:comment "e.g. 'Percy Street entrance is closed due to storm damage.' vs '... closed following storm damage.' vs '... closed because of storm damage.'" .

para:phrase_due_to
    a para:ParaphrasePhrase ;
    rdfs:label "due to" ;
    para:memberOf para:CausalConnective ;
    para:form "name" .

para:phrase_following
    a para:ParaphrasePhrase ;
    rdfs:label "following" ;
    para:memberOf para:CausalConnective ;
    para:form "name" .

para:phrase_because_of
    a para:ParaphrasePhrase ;
    rdfs:label "because of" ;
    para:memberOf para:CausalConnective ;
    para:form "name" .

para:phrase_owing_to
    a para:ParaphrasePhrase ;
    rdfs:label "owing to" ;
    para:memberOf para:CausalConnective ;
    para:form "name" .

para:phrase_as_a_result_of
    a para:ParaphrasePhrase ;
    rdfs:label "as a result of" ;
    para:memberOf para:CausalConnective ;
    para:form "name" .

# ---------------------------------------------------------------------------
# Multi-word imperative notice actions. These collapse phrasal forms that
# CoreNLP otherwise splits into a verb + adjective/particle (e.g. 'make safe'
# parsed as make(X[safe])) onto canonical single-verb concepts used by
# downstream ex-post comparison.
# ---------------------------------------------------------------------------

para:NoticeActionSecure
    a para:ParaphraseConcept ;
    rdfs:label "notice_action_secure" ;
    rdfs:comment "Imperative notice action for securing infrastructure, e.g. 'make safe' a leak/collapse vs 'secure the site'." .

para:phrase_make_safe
    a para:ParaphrasePhrase ;
    rdfs:label "make safe" ;
    para:memberOf para:NoticeActionSecure ;
    para:form "name" .

para:phrase_secure
    a para:ParaphrasePhrase ;
    rdfs:label "secure" ;
    para:memberOf para:NoticeActionSecure ;
    para:form "name" .

para:NoticeActionPerform
    a para:ParaphraseConcept ;
    rdfs:label "notice_action_perform" ;
    rdfs:comment "Imperative notice action for execution, e.g. 'carry out works' vs 'perform works'." .

para:phrase_carry_out
    a para:ParaphrasePhrase ;
    rdfs:label "carry out" ;
    para:memberOf para:NoticeActionPerform ;
    para:form "name" .

para:phrase_perform
    a para:ParaphrasePhrase ;
    rdfs:label "perform" ;
    para:memberOf para:NoticeActionPerform ;
    para:form "name" .
